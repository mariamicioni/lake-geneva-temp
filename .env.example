# Copy to .env and fill in. Never commit .env.
# MLflow tracking + model registry, hosted on DagsHub (used by src/lakegeneva/training/train.py;
# without these lines the runs go to a local mlflow.db and mlruns/)
MLFLOW_TRACKING_URI=https://dagshub.com/<user>/lake-geneva-temp.mlflow
MLFLOW_TRACKING_USERNAME=<dagshub-user>
MLFLOW_TRACKING_PASSWORD=<dagshub-token>
# Google Cloud Storage (feature store + DVC remote)
GCS_BUCKET=gs://your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
