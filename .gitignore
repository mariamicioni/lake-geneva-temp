# secrets
.env
# python
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
# data & models (never in git)
# The two data folders: their content is versioned with DVC and kept in the GCS
# bucket; Git keeps only the small pointer files data/raw.dvc and data/features.dvc.
# (DVC also lists them in data/.gitignore.) Not "data/" or "data/*": with such a
# rule DVC on Windows skips the whole data folder and loses the pointer files
# (checked on 27.10.2026).
/data/raw/
/data/features/
# Any CSV or Parquet file anywhere, as a second safety net ...
*.parquet
*.csv
# ... except the small test sample (4 days of real BAFU readings) used by the tests
!tests/fixtures/*.csv
mlruns/
mlartifacts/
models/
*.pkl
*.joblib
# os / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
